---
import slug from "slug"
import "mapbox-gl/dist/mapbox-gl.css"
import VariantLayout from "../../../variants/VariantLayout.astro"
import Flower from "../../../variants/Flower.astro"
import Mapbox from "../../../components/statistics/Mapbox"
import { statsData } from "../../../variants/data"

const s = await statsData()
const charts = [
  { title: "Restaurants by country", bars: s.byCountry },
  { title: "Restaurants by year", bars: s.byYear },
  { title: "Stars by year", bars: s.starsByYear },
  { title: "Restaurants by Google rating", bars: s.byRating },
]
const metrics = [
  { value: s.totalStars, label: "Stars collected" },
  { value: s.restaurantCount, label: "Restaurants visited" },
  { value: `€${s.spentPerPerson.toLocaleString("en-GB")}`, label: "Spent per person" },
  { value: `€${s.averageBill}`, label: "Average bill for two" },
]
---

<VariantLayout
  title="Statistics on our foodie journeys"
  description="Statistics on our Michelin-starred foodie journeys."
  fonts="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..900;1,300..900&display=swap"
  page="statistics"
>
  <div class="swiss">
    <header class="topbar g12">
      <span class="meta">{s.byYear[0]?.label}–{s.byYear[s.byYear.length - 1]?.label}</span>
      <nav>
        <a href="/variants/swiss/">Index</a>
        <a href="/variants/swiss/statistics" aria-current="page">Statistics</a>
      </nav>
    </header>

    <section class="hero g12">
      <p class="eyebrow">Figures</p>
      <h1>The numbers<br />behind the plates.</h1>
    </section>

    <section class="metrics g12">
      {
        metrics.map((m) => (
          <div class="metric">
            <span class="big">{m.value}</span>
            <span class="label">{m.label}</span>
          </div>
        ))
      }
    </section>

    <section class="block g12">
      <h2 class="section-label">01 Map</h2>
      <div class="wide">
        <div id="map" class="map"></div>
        <Mapbox
          places={s.places}
          mapStyle="mapbox://styles/mapbox/light-v11"
          markerColor="#d3072b"
          client:only="react"
        />
      </div>
    </section>

    <section class="block g12">
      <h2 class="section-label">02 Distribution</h2>
      <div class="wide charts">
        {
          charts.map((chart) => {
            const max = Math.max(...chart.bars.map((b) => b.value))
            return (
              <figure class="chart">
                <figcaption>{chart.title}</figcaption>
                <ul>
                  {chart.bars.map((b) => (
                    <li>
                      <span class="bar-label">{b.label}</span>
                      <span class="bar-track">
                        <span class:list={["bar", { top: b.value === max }]} style={`width:${(b.value / max) * 100}%`} />
                      </span>
                      <span class="bar-value">{b.value}</span>
                    </li>
                  ))}
                </ul>
              </figure>
            )
          })
        }
      </div>
    </section>

    <section class="block g12">
      <h2 class="section-label">03 Coverage<span class="muted"><br />visited / all starred</span></h2>
      <div class="wide coverage">
        {
          s.coverage.map((c) => (
            <div class="country">
              <h3>{c.country}</h3>
              {c.rows.map((r) => (
                <div class="cov-row">
                  <Flower count={r.stars} size="0.7rem" class="red" />
                  <span class="cov-track">
                    <span class="cov-bar" style={`width:${Math.max((r.visited / r.total) * 100, r.visited ? 2 : 0)}%`} />
                  </span>
                  <span class="cov-num">
                    {r.visited}
                    <span class="muted">/{r.total}</span>
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section class="block g12">
      <h2 class="section-label">04 Table<span class="muted"><br />click headers to sort</span></h2>
      <div class="wide table-wrap">
        <table data-sortable>
          <thead>
            <tr>
              <th data-sort="text">Restaurant</th>
              <th data-sort="num">Stars</th>
              <th data-sort="num" class="hide-sm">Food</th>
              <th data-sort="num" class="hide-sm">Wine</th>
              <th data-sort="num" class="hide-sm">Google</th>
              <th data-sort="num" class="hide-sm">€ p.p.</th>
              <th data-sort="text" class="hide-sm">Country</th>
              <th data-sort="text"><span class="date-full">Date</span><span class="date-year">Year</span></th>
            </tr>
          </thead>
          <tbody>
            {
              s.table.map((r) => (
                <tr>
                  <td>
                    <a href={`/variants/swiss/#${slug(r.name)}`}>{r.name}</a>
                  </td>
                  <td data-value={r.stars}>
                    <Flower count={r.stars} size="0.7rem" class="red" />
                  </td>
                  <td class="num hide-sm">{r.food || "–"}</td>
                  <td class="num hide-sm">{r.wine || "–"}</td>
                  <td class="num hide-sm">{r.rating.toFixed(1)}</td>
                  <td class="num hide-sm">{r.spent}</td>
                  <td class="hide-sm">{r.country}</td>
                  <td class="num" data-value={r.date}>
                    <span class="date-full">{r.date}</span>
                    <span class="date-year">{r.date.slice(0, 4)}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <footer class="g12 foot">
      <a href="/variants/swiss/">← Index</a>
    </footer>
  </div>
</VariantLayout>

<script>
  import { initSortable } from "../../../variants/sortable"
  initSortable()
</script>

<style is:global>
  html {
    background: #f7f6f2;
  }
  .swiss {
    --ink: #0b0b0b;
    --paper: #f7f6f2;
    --red: #d3072b;
    --muted: #6d6b66;
    --rule: #0b0b0b;
    --hair: #d9d6cf;
    --gutter: clamp(16px, 3vw, 40px);
    font-family: "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: var(--paper);
    font-size: 16px;
    line-height: 1.45;
    padding: 0 var(--gutter) 96px;
    max-width: 1440px;
    margin: 0 auto;
    -webkit-font-smoothing: antialiased;
  }
  .swiss a {
    color: inherit;
  }
  .swiss .g12 {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .swiss .red {
    color: var(--red);
  }
  .swiss .muted {
    color: var(--muted);
    font-weight: 500;
  }

  .swiss .topbar {
    align-items: baseline;
    padding: 20px 0 14px;
    border-bottom: 2px solid var(--rule);
    font-size: 14px;
    font-weight: 600;
  }
  .swiss .topbar .meta {
    grid-column: 1 / span 8;
    color: var(--muted);
    font-weight: 500;
  }
  .swiss .topbar nav {
    grid-column: 9 / -1;
    display: flex;
    gap: 24px;
    justify-content: flex-end;
  }
  .swiss .topbar nav a {
    text-decoration: none;
    color: var(--muted);
  }
  .swiss .topbar nav a[aria-current="page"],
  .swiss .topbar nav a:hover {
    color: var(--ink);
  }

  .swiss .hero {
    padding: clamp(48px, 10vw, 140px) 0 clamp(40px, 6vw, 80px);
  }
  .swiss .eyebrow {
    grid-column: 1 / span 3;
    margin: 0;
    padding-top: 1.1em;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .swiss h1 {
    grid-column: 4 / -1;
    margin: 0;
    font-size: clamp(2.6rem, 7.4vw, 7.5rem);
    line-height: 0.92;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .swiss .metrics {
    border-top: 2px solid var(--rule);
  }
  .swiss .metric {
    grid-column: span 3;
    display: grid;
    align-content: start;
    padding: 16px 0 28px;
    border-right: 1px solid var(--hair);
  }
  .swiss .metric:last-child {
    border-right: 0;
  }
  .swiss .metric .big {
    font-size: clamp(2.5rem, 5.5vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.05em;
    margin-bottom: 12px;
  }
  .swiss .metric .label {
    font-size: 14px;
    font-weight: 600;
  }

  .swiss .block {
    border-top: 2px solid var(--rule);
    padding-top: 16px;
    margin-top: 64px;
  }
  .swiss .section-label {
    grid-column: 1 / span 3;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
  }
  .swiss .wide {
    grid-column: 4 / -1;
  }

  .swiss .map {
    height: clamp(320px, 50vw, 560px);
    background: #e9e7e1;
  }
  .swiss .mapboxgl-popup-content {
    border-radius: 0;
    font-family: inherit;
    box-shadow: none;
    border: 1.5px solid var(--ink);
  }

  .swiss .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px var(--gutter);
  }
  .swiss .chart {
    margin: 0;
  }
  .swiss .chart figcaption {
    font-size: 14px;
    font-weight: 700;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
  }
  .swiss .chart ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .swiss .chart li {
    display: grid;
    grid-template-columns: 96px 1fr 28px;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 14px;
  }
  .swiss .bar-track {
    height: 10px;
  }
  .swiss .bar {
    display: block;
    height: 100%;
    background: var(--ink);
  }
  .swiss .chart .bar.top {
    background: var(--red);
  }
  .swiss .bar-value {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .swiss .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 32px var(--gutter);
  }
  .swiss .country h3 {
    margin: 0 0 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--ink);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .swiss .cov-row {
    display: grid;
    grid-template-columns: 48px 1fr 56px;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    font-size: 14px;
  }
  .swiss .cov-track {
    height: 6px;
    background: var(--hair);
  }
  .swiss .cov-bar {
    display: block;
    height: 100%;
    background: var(--red);
  }
  .swiss .cov-num {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .swiss .table-wrap {
    overflow-x: auto;
  }
  .swiss table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .swiss th {
    text-align: left;
    padding: 0 12px 8px 0;
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
  }
  .swiss th button {
    all: unset;
    cursor: pointer;
    font-weight: 700;
  }
  .swiss th button:focus-visible {
    outline: 2px solid var(--red);
  }
  .swiss th[aria-sort] button {
    color: var(--red);
  }
  .swiss th[aria-sort="descending"] button::after {
    content: " ↓";
  }
  .swiss th[aria-sort="ascending"] button::after {
    content: " ↑";
  }
  .swiss td {
    padding: 9px 12px 9px 0;
    border-bottom: 1px solid var(--hair);
    vertical-align: middle;
  }
  .swiss td a {
    text-decoration: none;
    font-weight: 600;
  }
  .swiss td a:hover {
    color: var(--red);
  }
  .swiss td.num {
    font-variant-numeric: tabular-nums;
  }
  .swiss .date-year {
    display: none;
  }
  .swiss tbody tr:hover {
    background: #efede7;
  }

  .swiss .foot {
    margin-top: 64px;
    padding-top: 14px;
    border-top: 2px solid var(--rule);
    font-size: 14px;
    font-weight: 600;
  }
  .swiss .foot a {
    grid-column: 7 / -1;
    justify-self: end;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .swiss .eyebrow,
    .swiss h1,
    .swiss .section-label,
    .swiss .wide {
      grid-column: 1 / -1;
    }
    .swiss .eyebrow {
      padding: 0 0 16px;
    }
    .swiss .section-label {
      margin-bottom: 24px;
    }
    .swiss .metric {
      grid-column: span 6;
      border-right: 0;
      border-bottom: 1px solid var(--hair);
    }
    .swiss .charts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .swiss .topbar .meta {
      grid-column: 1 / span 6;
    }
    .swiss .topbar nav {
      grid-column: 7 / -1;
      gap: 14px;
    }
    .swiss .hide-sm,
    .swiss .date-full {
      display: none;
    }
    .swiss .date-year {
      display: inline;
    }
  }
</style>
