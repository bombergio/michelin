---
// Michelin flower glyph, coloured via currentColor
export interface Props {
  count: number
  size?: string
  class?: string
}

const { count, size = "1em", class: className = "" } = Astro.props
const d =
  "M624 69v-49q0 -74 -47 -122t-119 -48q-78 0 -122 49t-44 131v15q0 4 1 7l1 17q-74 -53 -133 -53q-46 0 -88 31q-40 29 -59 76q-14 33 -14 66q0 101 116 154l15 7q-131 60 -131 162q0 69 48 121t114 52q60 0 119 -43l13 -10q-2 20 -2 48q0 75 47 122.5t119 47.5q79 0 122.5 -49.5t43.5 -129.5v-39q74 53 132 53q65 0 112.5 -52.5t47.5 -120.5q0 -102 -116 -155l-15 -7q131 -60 131 -161q0 -65 -47 -119t-113.5 -54t-117.5 42zM540 238q116 -169 215 -169q41 0 74.5 37t33.5 83q0 124 -268 147v29q133 11 200.5 48t67.5 99q0 45 -32.5 82.5t-75.5 37.5q-101 0 -215 -170l-26 15q57 116 57 196q0 124 -113 124q-54 0 -84 -33q-29 -35 -29 -88q0 -80 57 -199l-26 -15q-114 170 -215 170q-41 0 -74.5 -35.5t-33.5 -84.5q0 -124 267 -147v-29q-267 -22 -267 -147q0 -44 32 -82t76 -38q99 0 215 169l26 -14q-57 -117 -57 -200q0 -53 29 -88q30 -33 84 -33q113 0 113 123q0 81 -57 198z"
---

<span
  class:list={["flowers", className]}
  style={`font-size:${size}`}
  role="img"
  aria-label={`${count} Michelin star${count > 1 ? "s" : ""}`}
>
  {
    Array.from({ length: count }, () => (
      <svg viewBox="0 -150 916 1000" width="1em" height="1em" aria-hidden="true">
        <path fill="currentColor" d={d} />
      </svg>
    ))
  }
</span>

<style>
  .flowers {
    display: inline-flex;
    gap: 0.2em;
    vertical-align: middle;
  }
</style>
