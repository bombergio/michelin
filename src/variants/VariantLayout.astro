---
import { SEO } from "astro-seo"
import "../styles/global.css"

export interface Props {
  title: string
  description: string
  fonts: string
  page: "index" | "statistics"
}

const { title, description, fonts, page } = Astro.props
const options = [
  { key: "swiss", label: "Swiss", href: `/variants/swiss/${page === "index" ? "" : "statistics"}` },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <SEO title={title} description={description} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <nav class="variant-switch" aria-label="Design variants">
      {
        options.map((o) => (
          <a href={o.href} aria-current="page">
            {o.label}
          </a>
        ))
      }
      <a href={page === "index" ? "/" : "/statistics"}>Current</a>
    </nav>
  </body>
</html>

<style>
  .variant-switch {
    position: fixed;
    bottom: 16px;
    right: 16px;
    max-width: calc(100vw - 32px);
    overflow-x: auto;
    z-index: 50;
    display: flex;
    gap: 2px;
    padding: 4px;
    background: #111;
    border-radius: 999px;
    font: 500 12px/1 system-ui, sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.2);
  }
  .variant-switch a {
    color: #bbb;
    padding: 8px 12px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }
  .variant-switch a:hover {
    color: #fff;
  }
  .variant-switch a[aria-current="page"] {
    background: #fff;
    color: #111;
  }
</style>
